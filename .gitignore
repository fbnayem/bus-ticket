# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts

# Compiled Go binaries and their run logs. `go build ./services/api/cmd/api`
# regenerates bin/api.exe; committing a 16 MB binary would dwarf the source.
bin/
*.exe
*.log
*.err

# Test artefacts — the browser suites write screenshots on every run
artifacts/
playwright-report/
test-results/

# Local environment
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
*.swp

# Go
vendor/
*.test

# TypeScript incremental build cache
*.tsbuildinfo

# Signing keys and their passwords. NEVER commit these.
#
# A signing key in version control is a signing key everybody who has ever
# cloned the repository can publish updates with, and unlike a leaked password
# it cannot be rotated without orphaning every phone that already has the app.
# See apps/mobile/*/android/keystore.md.
**/key.properties
*.jks
*.keystore
*.p12
*.mobileprovision

# Gradle output. The Flutter templates ignore each app's own build/ but not the
# one Gradle writes under android/, and a release APK is 70 MB.
apps/mobile/*/android/build/
apps/mobile/*/android/.gradle/
